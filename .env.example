# Supabase Configuration (Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Razorpay Configuration (Frontend)
# Get from https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Supabase Edge Functions Secrets
# These are set in Supabase dashboard > Project Settings > Secrets
# NOT in .env file
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
SUPABASE_URL=https://your-project.supabase.co (automatically available)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
JWT_SECRET=your_supabase_jwt_secret

# AI Recommendation Function Secrets (Gemini Studio)
GEMINI_API_KEY=your_gemini_studio_api_key
GEMINI_MODEL=gemini-2.0-flash

# Optional model override for blog generation edge function
GEMINI_MODEL_BLOG=gemini-2.0-flash

# B2B sales automation
GEMINI_MODEL_B2B=gemini-2.0-flash
RESEND_API_KEY=your_resend_api_key
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret
B2B_FROM_EMAIL=Advaya Care Trade <trade@advayacare.com>
B2B_REPLY_TO_EMAIL=support@advayacare.com
B2B_CRON_SECRET=replace_with_a_long_random_value
